# Optional. GA4 measurement ID (G-XXXXXXXX). Leave empty to skip analytics.
# VITE_GA_MEASUREMENT_ID=

# Optional. Google Search Console HTML-tag verification token.
# VITE_GOOGLE_SITE_VERIFICATION=
